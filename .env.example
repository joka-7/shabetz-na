# Copy to .env and adjust. Never commit the real file.

SHABETZ_ENVIRONMENT=dev

# "server" for the hosted website; the desktop app sets "desktop" itself.
SHABETZ_DEPLOYMENT=server

# MySQL: utf8mb4 matters, since MySQL's "utf8" is a three-byte subset that
# mangles characters outside the Basic Multilingual Plane.
# PostgreSQL: paste the URL as the host gives it, e.g. postgres://u:p@host/db.
SHABETZ_DATABASE_URL=mysql+pymysql://shabetz:shabetz@127.0.0.1:3306/shabetz?charset=utf8mb4

# A long random value, kept the same across restarts. (Sessions are database
# rows and do not depend on it.)
SHABETZ_SECRET_KEY=

SHABETZ_SESSION_TTL_HOURS=12
# Set true behind HTTPS so the session cookie is never sent in clear.
SHABETZ_COOKIE_SECURE=false

# Google sign-in through Firebase: the web app config from the Firebase
# console (Project settings > Your apps). With it, anyone can sign up with
# Google and create projects. Left blank, there is no Google button and the
# first administrator is created with a password and the setup code instead.
SHABETZ_FIREBASE_API_KEY=
SHABETZ_FIREBASE_AUTH_DOMAIN=
SHABETZ_FIREBASE_PROJECT_ID=
SHABETZ_FIREBASE_APP_ID=

# Only needed when the frontend is served from a different origin. In
# development Vite proxies /api, so requests are same-origin and this stays
# empty.
SHABETZ_CORS_ORIGINS=

# Normally left empty: `shabetz serve` prints a fresh one-time code while no
# administrator exists. Set it only to choose the code yourself.
SHABETZ_SETUP_TOKEN=

# The reverse proxy in front of the server. Without it, per-address sign-in
# throttling sees every visitor as the proxy.
SHABETZ_FORWARDED_ALLOW_IPS=127.0.0.1
