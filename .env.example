# Copy to .env and adjust. Never commit the real file.

SHABETZ_ENVIRONMENT=dev

# utf8mb4 matters: MySQL's "utf8" is a three-byte subset that mangles
# characters outside the Basic Multilingual Plane.
SHABETZ_DATABASE_URL=mysql+pymysql://shabetz:shabetz@127.0.0.1:3306/shabetz?charset=utf8mb4

# Required when SHABETZ_ENVIRONMENT=prod. Startup fails rather than minting an
# ephemeral key, which would silently invalidate every session on restart.
SHABETZ_SECRET_KEY=

SHABETZ_SESSION_TTL_HOURS=12
# Set true behind HTTPS so the session cookie is never sent in clear.
SHABETZ_COOKIE_SECURE=false

# Google sign-in is optional. Left blank, the button is hidden and the routes
# are absent rather than failing.
SHABETZ_GOOGLE_CLIENT_ID=
SHABETZ_GOOGLE_CLIENT_SECRET=
SHABETZ_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Only needed when the frontend is served from a different origin. In
# development Vite proxies /api, so requests are same-origin and this stays
# empty.
SHABETZ_CORS_ORIGINS=
